{
  "name": "opportunity-management",
  "description": "AWS Partner Central API Opportunity Management Sample",
  "version": "0.2.4",
  "private": true,
  "homepage": "https://mingzhulex.github.io/opportunityManagement",
  "dependencies": {
    "@aws-crypto/sha256-browser": "^5.2.0",
    "@aws-sdk/client-marketplace-agreement": "^3.893.0",
    "@aws-sdk/client-marketplace-catalog": "^3.893.0",
    "@aws-sdk/client-partnercentral-selling": "^3.821.0",
    "@aws-sdk/credential-providers": "^3.895.0",
    "@aws-sdk/signature-v4": "^3.374.0",
    "@cloudscape-design/components": "^3.0.0",
    "@cloudscape-design/global-styles": "^1.0.0",
    "aws-sdk": "^2.1400.0",
    "axios": "^1.10.0",
    "concurrently": "^7.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "GENERATE_SOURCEMAP=false react-scripts build",
    "build-safe": "rm -f .env.local && GENERATE_SOURCEMAP=false react-scripts build",
    "build-harmony-app": "GENERATE_SOURCEMAP=false PUBLIC_URL=/opportunity-management react-scripts build && tar -cvf app.tar build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "sync-creds": "node sync-credentials.js",
    "server": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm start\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-unused-vars": "warn",
      "jsx-a11y/anchor-is-valid": "warn"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  },
  "overrides": {
    "uglify-js": "^3.17.4",
    "postcss": "^8.4.31",
    "webpack-dev-server": "^4.15.2",
    "nth-check": "^2.1.1"
  }
}
